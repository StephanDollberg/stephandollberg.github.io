---
import { NAV_LINKS, SITE } from "../site";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === "/") {
    return currentPath === "/";
  }

  return currentPath.startsWith(href);
}
---

<header id="main-header">
  <div id="site-title">
    <img id="profile_roundcorners" src="/images/profile.jpg" alt="Stephan Dollberg" />
    <a href="/">{SITE.title}</a>
  </div>

  <nav class="links" aria-label="Primary">
    {NAV_LINKS.map((link) => (
      <a href={link.href} class:list={{ active: isActive(link.href) }}>{link.label}</a>
    ))}
    <span class="social-links">
      <a href={`mailto:${SITE.email}`} target="_blank" rel="noreferrer">
        <i class="fa fa-envelope" aria-hidden="true"></i>
        <span class="sr-only">Email</span>
      </a>
      <a href={SITE.githubUrl} target="_blank" rel="noreferrer">
        <i class="fa fa-github" aria-hidden="true"></i>
        <span class="sr-only">GitHub</span>
      </a>
      <a href={SITE.stackOverflowUrl} target="_blank" rel="noreferrer">
        <i class="fa fa-stack-overflow" aria-hidden="true"></i>
        <span class="sr-only">Stack Overflow</span>
      </a>
    </span>
  </nav>
</header>
